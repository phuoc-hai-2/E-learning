@model Elysia.Models.Payment
@{
    ViewData["Title"] = "Kết quả thanh toán";
}

<div class="container mt-5 text-center">
    <div class="card shadow-lg mx-auto border-0 overflow-hidden" style="max-width: 500px; border-radius: 15px;">
        <div class="card-header @(Model.Status == "Completed" ? "bg-success" : "bg-danger") text-white py-4">
            <div class="mb-2">
                <i class="fas @(Model.Status == "Completed" ? "fa-check-circle" : "fa-times-circle") fa-4x"></i>
            </div>
            <h4 class="fw-bold m-0">@(Model.Status == "Completed" ? "THANH TOÁN THÀNH CÔNG" : "GIAO DỊCH THẤT BẠI")</h4>
        </div>
        <div class="card-body p-5 bg-white">
            <h6 class="text-muted text-uppercase small mb-4">Chi tiết đơn hàng #@Model.PaymentID</h6>

            <ul class="list-group list-group-flush mb-4 text-start">
                <li class="list-group-item d-flex justify-content-between py-3">
                    <span class="text-muted">Khóa học</span>
                    <span class="fw-bold text-end text-dark" style="max-width: 200px;">@Model.Enrollment.Course.Title</span>
                </li>
                <li class="list-group-item d-flex justify-content-between py-3">
                    <span class="text-muted">Số tiền</span>
                    <span class="text-danger fw-bold">@Model.Amount.ToString("N0") VNĐ</span>
                </li>
                <li class="list-group-item d-flex justify-content-between py-3">
                    <span class="text-muted">Cổng thanh toán</span>
                    <span class="fw-bold">VNPAY</span>
                </li>
            </ul>

            @if (Model.Status == "Completed")
            {
                <p class="text-muted mb-4 small">Cảm ơn bạn đã đăng ký. Bạn có thể bắt đầu học ngay bây giờ.</p>
                <a asp-controller="Courses" asp-action="Watch" asp-route-id="@Model.Enrollment.CourseID" class="btn btn-primary btn-lg w-100 shadow fw-bold py-3 rounded-pill">
                    <i class="fas fa-play-circle me-2"></i> VÀO LỚP HỌC
                </a>
            }
            else
            {
                <p class="text-muted mb-4 small">Giao dịch chưa hoàn tất hoặc bị hủy. Vui lòng thử lại.</p>
                <a asp-controller="Courses" asp-action="Details" asp-route-id="@Model.Enrollment.CourseID" class="btn btn-outline-secondary w-100 py-2 rounded-pill">
                    Thử lại
                </a>
            }
        </div>
    </div>
</div>