@model Elysia.Models.Payment

<div class="container py-5 text-center">
    <div class="card shadow-sm mx-auto" style="max-width: 600px;">
        <div class="card-body p-5">
            @if (Model.Status == "Success" || Model.Status == "00")
            {
                <div class="text-success mb-4">
                    <i class="bi bi-check-circle-fill" style="font-size: 4rem;"></i>
                </div>
                <h2 class="card-title text-success">Thanh toán thành công!</h2>
                <p class="card-text">Chúc mừng bạn đã sở hữu khóa học <strong>@Model.Enrollment.Course.Title</strong>.</p>
                <div class="mt-4">
                    <a href="/Courses/Watch?id=@Model.Enrollment.CourseID" class="btn btn-primary btn-lg px-4">
                        <i class="bi bi-play-circle me-2"></i>Vào học ngay
                    </a>
                </div>
            }
            else
            {
                <div class="text-danger mb-4">
                    <i class="bi bi-x-circle-fill" style="font-size: 4rem;"></i>
                </div>
                <h2 class="card-title text-danger">Thanh toán thất bại</h2>
                <p class="card-text">Giao dịch chưa hoàn tất hoặc bị hủy. Vui lòng thử lại.</p>
                <div class="mt-4">
                    <a href="/Payment/CreatePayment?paymentId=@Model.PaymentID" class="btn btn-warning btn-lg px-4">
                        <i class="bi bi-arrow-repeat me-2"></i>Thử lại
                    </a>
                    <a href="/" class="btn btn-outline-secondary ms-2">Về trang chủ</a>
                </div>
            }
        </div>
        <div class="card-footer text-muted small">
            Mã giao dịch: @(Model.TransactionId ?? "N/A") | Trạng thái: @Model.Status
        </div>
    </div>
</div>