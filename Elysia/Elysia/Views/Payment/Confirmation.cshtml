@model Elysia.Models.Payment

@{
    ViewData["Title"] = "Kết quả thanh toán";
    // Kiểm tra trạng thái thành công (bao gồm cả mã cũ và mới để an toàn)
    bool isSuccess = Model.Status == "Success" || Model.Status == "00" || Model.Status == "Completed";
}

<div class="container d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="card shadow-lg border-0 rounded-4" style="max-width: 500px; width: 100%;">
        <div class="card-body p-5 text-center">

            @if (isSuccess)
            {
                <div class="mb-4 animate__animated animate__bounceIn">
                    <div class="d-inline-flex align-items-center justify-content-center bg-success bg-opacity-10 rounded-circle" style="width: 100px; height: 100px;">
                        <i class="bi bi-check-lg text-success" style="font-size: 3.5rem;"></i>
                    </div>
                </div>

                <h2 class="fw-bold text-success mb-3">Thanh toán thành công!</h2>
                <p class="text-muted mb-4 fs-5">
                    Chúc mừng bạn đã sở hữu khóa học <br>
                    <strong class="text-dark">@Model.Enrollment.Course.Title</strong>
                </p>

                <div class="d-grid gap-2">
                    <a href="/Courses/Watch?id=@Model.Enrollment.CourseID" class="btn btn-success btn-lg rounded-pill fw-bold shadow-sm py-3">
                        <i class="bi bi-play-circle-fill me-2"></i> Vào học ngay
                    </a>
                    <a href="/Courses/Index" class="btn btn-outline-secondary rounded-pill py-2">
                        Quay lại khóa học của tôi
                    </a>
                </div>
            }
            else
            {
                <div class="mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-danger bg-opacity-10 rounded-circle" style="width: 100px; height: 100px;">
                        <i class="bi bi-x-lg text-danger" style="font-size: 3.5rem;"></i>
                    </div>
                </div>

                <h2 class="fw-bold text-danger mb-3">Thanh toán thất bại</h2>
                <p class="text-muted mb-4">
                    Rất tiếc, giao dịch chưa hoàn tất hoặc đã bị hủy.<br>
                    Vui lòng kiểm tra lại thông tin.
                </p>

                <div class="d-grid gap-2">
                    <a href="/Payment/CreatePayment?paymentId=@Model.PaymentID" class="btn btn-warning btn-lg rounded-pill fw-bold text-dark shadow-sm py-3">
                        <i class="bi bi-arrow-clockwise me-2"></i> Thử thanh toán lại
                    </a>
                    <a href="/" class="btn btn-outline-secondary rounded-pill py-2">
                        Về trang chủ
                    </a>
                </div>
            }

        </div>

        <div class="card-footer bg-light border-0 py-3 text-center rounded-bottom-4">
            <small class="text-muted d-block">
                Mã giao dịch: <span class="font-monospace fw-bold">#@Model.PaymentID</span>
            </small>
            <small class="text-muted">
                Số tiền: <span class="fw-bold text-dark">@Model.Amount.ToString("#,##0") đ</span>
            </small>
        </div>
    </div>
</div>