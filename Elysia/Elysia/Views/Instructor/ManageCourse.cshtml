@model Elysia.Models.Course

@{
    ViewData["Title"] = "Quản Lý Khóa Học: " + Model.Title;
}

<div class="pt-4">
    <h1 class="display-5 fw-bold mb-2">@Model.Title</h1>
    <p class="lead text-muted">
        Tình trạng:
        @if (Model.IsApproved)
        {
            <span class="badge bg-success">Đã Duyệt</span>
        }
        else
        {
            <span class="badge bg-warning text-dark">Chờ Duyệt</span>
        }
    </p>

    <div class="row mt-4">
        @* Cột 1: Chi tiết & Thống kê Khóa học *@
        <div class="col-lg-4 mb-4">
            <div class="card shadow-sm h-100">
                <img src="@Model.ImageUrl" class="card-img-top" alt="Hình ảnh khóa học" style="height: 200px; object-fit: cover;">
                <div class="card-body">
                    <h5 class="card-title border-bottom pb-2 mb-3">Tổng quan</h5>
                    <p class="card-text small">
                        <strong>Số lượng Bài giảng:</strong> @Model.Lectures.Count <br />
                        <strong>Số lượng Học viên:</strong> @Model.Enrollments.Count <br />
                        <strong>Giá:</strong> @Model.Price.ToString("N0") VNĐ
                    </p>
                </div>
                <div class="card-footer d-flex justify-content-between">
                    <a asp-action="Edit" asp-route-id="@Model.CourseID" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-pencil"></i> Chỉnh sửa
                    </a>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>
                </div>
            </div>
        </div>

        @* Cột 2: Quản lý Bài giảng (Lectures) *@
        <div class="col-lg-8 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-list-task"></i> Danh sách Bài giảng</h5>
                    <a asp-action="CreateLecture" asp-route-courseId="@Model.CourseID" class="btn btn-light btn-sm fw-bold">
                        <i class="bi bi-plus-lg"></i> Thêm Bài giảng
                    </a>
                </div>
                <ul class="list-group list-group-flush">
                    @if (!Model.Lectures.Any())
                    {
                        <li class="list-group-item text-center text-muted py-4">Chưa có bài giảng nào được thêm.</li>
                    }
                    else
                    {
                        @foreach (var lecture in Model.Lectures.OrderBy(l => l.Order))
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="badge bg-secondary me-2">Bài @lecture.Order</span>
                                    <a asp-action="ManageLecture" asp-route-lectureId="@lecture.LectureID" class="text-decoration-none fw-bold">
                                        @lecture.Title
                                    </a>
                                </div>
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="ManageQuiz" asp-route-lectureId="@lecture.LectureID" class="btn btn-outline-info" title="Quản lý Quiz">
                                        <i class="bi bi-patch-question-fill"></i> Quiz
                                    </a>
                                    <a asp-action="EditLecture" asp-route-lectureId="@lecture.LectureID" class="btn btn-outline-secondary" title="Chỉnh sửa">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @* Form Xóa (sử dụng AJAX/JS hoặc modal để xác nhận) *@
                                    <form asp-action="DeleteLecture" method="post" onsubmit="return confirm('Bạn chắc chắn muốn xóa bài giảng: @lecture.Title?');">
                                        <input type="hidden" name="lectureId" value="@lecture.LectureID" />
                                        <button type="submit" class="btn btn-outline-danger" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </li>
                        }
                    }
                </ul>
            </div>
        </div>
    </div>
</div>