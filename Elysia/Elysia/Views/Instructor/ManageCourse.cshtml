@model Elysia.Models.Course
@{
    ViewData["Title"] = "Quản lý nội dung: " + Model.Title;
}

<div class="container py-4">
    <a asp-action="MyCourses" class="text-decoration-none text-muted mb-3 d-inline-block"><i class="fas fa-arrow-left"></i> Quay lại danh sách</a>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">@Model.Title</h2>
            <p class="text-muted small">Quản lý các bài giảng và bài tập</p>
        </div>
        <a asp-action="CreateLecture" asp-route-courseId="@Model.CourseID" class="btn btn-primary"><i class="fas fa-plus-circle"></i> Thêm bài giảng</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white fw-bold">Danh sách bài giảng</div>
        <div class="list-group list-group-flush">
            @if (!Model.Lectures.Any())
            {
                <div class="p-4 text-center text-muted">Chưa có bài giảng nào.</div>
            }
            else
            {
                @foreach (var l in Model.Lectures.OrderBy(x => x.Order))
                {
                    <div class="list-group-item p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center">
                                <span class="badge bg-secondary me-3">#@l.Order</span>
                                <div>
                                    <h6 class="mb-0 fw-bold">@l.Title</h6>
                                    <small class="text-muted">Video: @(string.IsNullOrEmpty(l.VideoUrl) ? "Chưa có" : "Đã tải lên")</small>
                                </div>
                            </div>
                            <div>
                                <a asp-action="ManageQuiz" asp-route-lectureId="@l.LectureID" class="btn btn-sm btn-outline-warning me-2">
                                    <i class="fas fa-question-circle"></i> Quiz
                                </a>
                                <a asp-action="EditLecture" asp-route-lectureId="@l.LectureID" class="btn btn-sm btn-outline-primary me-2">
                                    <i class="fas fa-edit"></i> Sửa
                                </a>
                                <form asp-action="DeleteLecture" method="post" class="d-inline" onsubmit="return confirm('Xóa bài giảng này?');">
                                    <input type="hidden" name="lectureId" value="@l.LectureID" />
                                    <button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>