@{
    ViewData["Title"] = "Thống kê Giảng viên";
}

<div class="container py-5">
    <h1 class="display-5 fw-bold text-primary mb-4"><i class="fas fa-chart-line"></i> Tổng quan</h1>

    <div class="row g-4">
        <!-- Card Total Courses -->
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100 bg-primary text-white">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase mb-2 opacity-75">Tổng số khóa học</h6>
                            <h2 class="display-4 fw-bold mb-0">@ViewBag.TotalCourses</h2>
                        </div>
                        <i class="fas fa-chalkboard-teacher fa-3x opacity-50"></i>
                    </div>
                </div>
                <div class="card-footer bg-white border-0 text-center">
                    <a asp-action="MyCourses" class="text-primary fw-bold text-decoration-none stretched-link">Quản lý khóa học <i class="fas fa-arrow-right ms-1"></i></a>
                </div>
            </div>
        </div>

        <!-- Placeholder for Students Count (Future Feature) -->
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100 bg-success text-white">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase mb-2 opacity-75">Học viên đang học</h6>
                            <h2 class="display-4 fw-bold mb-0">--</h2>
                        </div>
                        <i class="fas fa-users fa-3x opacity-50"></i>
                    </div>
                </div>
                <div class="card-footer bg-white border-0 text-center">
                    <span class="text-success fw-bold small">Chức năng đang phát triển</span>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3 text-dark">Thao tác nhanh</h5>
                    <div class="d-grid gap-2">
                        <a asp-action="Create" class="btn btn-outline-primary text-start">
                            <i class="fas fa-plus-circle me-2"></i> Tạo khóa học mới
                        </a>
                        <a asp-action="MyCourses" class="btn btn-outline-secondary text-start">
                            <i class="fas fa-list me-2"></i> Xem danh sách bài giảng
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>