@model Elysia.Models.Lecture

@{
    ViewData["Title"] = "Chỉnh Sửa Bài Giảng";
}

<div class="row justify-content-center pt-4">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Chỉnh Sửa Bài Giảng</h4>
            </div>
            <div class="card-body">
                <form asp-action="EditLecture" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    @* Giữ lại ID bài giảng và ID khóa học *@
                    <input type="hidden" asp-for="LectureID" />
                    <input type="hidden" asp-for="CourseID" />

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-bold">Tiêu đề bài giảng</label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Order" class="form-label fw-bold">Thứ tự hiển thị</label>
                        <input asp-for="Order" class="form-control" type="number" min="1" />
                        <span asp-validation-for="Order" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Video hiện tại</label>
                        @if (!string.IsNullOrEmpty(Model.VideoUrl))
                        {
                            <div class="mb-2">
                                <video width="100%" controls class="rounded border">
                                    <source src="@Model.VideoUrl" type="video/mp4">
                                    Trình duyệt của bạn không hỗ trợ thẻ video.
                                </video>
                            </div>
                            <p class="text-muted small">Đường dẫn: @Model.VideoUrl</p>
                        }
                        else
                        {
                            <p class="text-muted">Chưa có video.</p>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Thay đổi Video (Tùy chọn)</label>
                        <input type="file" name="videoFile" class="form-control" accept="video/*" />
                        <small class="text-muted">Chỉ tải lên nếu bạn muốn thay thế video hiện tại.</small>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="ManageCourse" asp-route-id="@Model.CourseID" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Quay lại
                        </a>

                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-save"></i> Lưu Thay Đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}