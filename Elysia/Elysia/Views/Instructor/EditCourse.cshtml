@model Elysia.Models.Course

@{
    ViewData["Title"] = "Chỉnh Sửa Khóa Học";
}

<div class="row pt-4 justify-content-center">
    <div class="col-lg-10">
        <h1 class="display-5 fw-bold mb-4"><i class="bi bi-pencil-square text-warning"></i> @ViewData["Title"]</h1>
        <p class="lead text-muted">Cập nhật thông tin chi tiết cho khóa học: <strong>@Model.Title</strong></p>

        <hr class="mb-5" />

        <div class="card shadow-lg p-4">
            <form asp-action="EditCourse" enctype="multipart/form-data" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                @* QUAN TRỌNG: Giữ lại ID khóa học để hệ thống biết đang sửa khóa nào *@
                <input type="hidden" asp-for="CourseID" />

                <div class="row">
                    @* Cột 1: Thông tin cơ bản *@
                    <div class="col-md-7">
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-bold">Tiêu đề Khóa học</label>
                            <input asp-for="Title" class="form-control form-control-lg" placeholder="Nhập tiêu đề khóa học..." />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold">Mô tả Khóa học</label>
                            <textarea asp-for="Description" class="form-control" rows="8" placeholder="Mô tả chi tiết nội dung khóa học..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Price" class="form-label fw-bold">Giá Khóa học (VNĐ)</label>
                            <input asp-for="Price" class="form-control" type="number" min="0" step="1000" />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                    </div>

                    @* Cột 2: Ảnh và Nút hành động *@
                    <div class="col-md-5">
                        <div class="card bg-light p-3 mb-4">
                            <h6 class="card-title fw-bold mb-3">Hình ảnh hiện tại</h6>

                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <div class="mb-3 text-center">
                                    <img src="@Model.ImageUrl" class="img-fluid rounded shadow-sm" alt="Ảnh khóa học" style="width: 100%; max-height: 250px; object-fit: cover;" />
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted py-4 border rounded bg-white">
                                    <i class="bi bi-image fs-1"></i>
                                    <p class="mb-0">Chưa có ảnh đại diện</p>
                                </div>
                            }

                            <div class="mt-3">
                                <label class="form-label fw-bold">Thay đổi hình ảnh (Tùy chọn)</label>
                                @* Name phải khớp với tham số IFormFile imageFile trong Controller *@
                                <input type="file" name="imageFile" id="imageFile" class="form-control" accept="image/*" />
                                <small class="text-muted mt-2 d-block">Để trống nếu bạn muốn giữ nguyên ảnh cũ.</small>
                            </div>
                        </div>

                        <hr />

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-warning btn-lg text-dark fw-bold">
                                <i class="bi bi-save"></i> Lưu Thay Đổi
                            </button>

                            @* Nút Quay lại dẫn về trang ManageCourse *@
                            <a asp-action="ManageCourse" asp-route-id="@Model.CourseID" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Quay lại Quản lý
                            </a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}