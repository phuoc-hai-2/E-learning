@model Elysia.Models.Quiz
@{
    ViewData["Title"] = "Quản lý Quiz";
}

<div class="container py-4">
    <div class="mb-4">
        <a asp-action="ManageCourse" asp-route-id="@Model.Lecture.CourseID" class="text-decoration-none text-muted mb-2 d-inline-block small"><i class="fas fa-arrow-left"></i> Quay lại khóa học</a>
        <h3 class="fw-bold text-dark">@Model.Title</h3>
        <p class="text-muted">Tạo bộ câu hỏi trắc nghiệm để kiểm tra kiến thức học viên sau bài giảng này.</p>
    </div>

    <!-- Form Add Question -->
    <div class="card shadow-sm mb-5 border-0 bg-light">
        <div class="card-body">
            <h5 class="fw-bold mb-3 text-primary"><i class="fas fa-plus-circle"></i> Thêm câu hỏi mới</h5>
            <form asp-action="AddQuestion" method="post">
                <input type="hidden" name="quizId" value="@Model.QuizID" />
                <div class="input-group">
                    <input type="text" name="questionText" class="form-control form-control-lg" placeholder="Nhập nội dung câu hỏi tại đây..." required />
                    <button class="btn btn-primary px-4 fw-bold">Thêm</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Question List -->
    @if (!Model.Questions.Any())
    {
        <div class="alert alert-warning text-center">Chưa có câu hỏi nào trong bài tập này.</div>
    }
    else
    {
        <h5 class="fw-bold mb-3">Danh sách câu hỏi (@Model.Questions.Count)</h5>
        @foreach (var q in Model.Questions)
        {
            <div class="card mb-3 border-0 shadow-sm">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                    <span class="fw-bold text-dark" style="font-size: 1.1rem;">@q.QuestionText</span>
                    <!-- Optional: Add Delete Question Button Here -->
                </div>
                <div class="card-body bg-white">
                    <ul class="list-group list-group-flush mb-3 rounded">
                        @foreach (var ans in q.Answers)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center @(ans.IsCorrect ? "list-group-item-success" : "")">
                                <span>@ans.AnswerText</span>
                                @if (ans.IsCorrect)
                                {
                                    <span class="badge bg-success rounded-pill"><i class="fas fa-check"></i> Đúng</span>
                                }
                            </li>
                        }
                    </ul>

                    <!-- Add Answer Form -->
                    <form asp-action="AddAnswer" method="post" class="row g-2 align-items-center mt-2 p-2 bg-light rounded">
                        <input type="hidden" name="questionId" value="@q.QuestionID" />
                        <div class="col-md-7">
                            <input type="text" name="answerText" class="form-control form-control-sm" placeholder="Nhập phương án trả lời..." required />
                        </div>
                        <div class="col-md-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="isCorrect" value="true" id="check_@q.QuestionID">
                                <label class="form-check-label small" for="check_@q.QuestionID">Là đáp án đúng</label>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-sm btn-outline-primary w-100 fw-bold">Thêm</button>
                        </div>
                    </form>
                </div>
            </div>
        }
    }
</div>