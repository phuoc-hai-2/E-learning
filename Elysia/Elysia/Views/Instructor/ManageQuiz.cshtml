@model Elysia.Models.Quiz
@* Giả định Quiz đã được load kèm Lecture, Questions và Answers *@

@{
    ViewData["Title"] = "Quản Lý Quiz: " + Model.Title;
}

<div class="pt-4">
    <h1 class="display-5 fw-bold mb-2"><i class="bi bi-patch-question-fill text-info"></i> @ViewData["Title"]</h1>
    <p class="lead text-muted">Gắn với Bài giảng: **@Model.Lecture.Title**</p>

    <hr class="mb-5" />

    <div class="row">
        @* Cột 1: Thêm Câu hỏi Mới *@
        <div class="col-lg-4 mb-4">
            <div class="card shadow-sm sticky-top" style="top: 15px;">
                <div class="card-header bg-info text-white h5">
                    <i class="bi bi-plus-circle"></i> Thêm Câu hỏi Mới
                </div>
                <div class="card-body">
                    <form asp-action="AddQuestion" method="post">
                        <input type="hidden" name="quizId" value="@Model.QuizID" />
                        <div class="mb-3">
                            <label for="questionText" class="form-label fw-bold">Nội dung Câu hỏi</label>
                            <textarea name="questionText" id="questionText" class="form-control" rows="3" required></textarea>
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-info text-white">Lưu Câu hỏi</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        @* Cột 2: Danh sách các Câu hỏi hiện có *@
        <div class="col-lg-8 mb-4">
            <h2 class="h4 border-bottom pb-2 mb-3">Danh sách Câu hỏi (@Model.Questions.Count)</h2>

            @if (!Model.Questions.Any())
            {
                <div class="alert alert-warning text-center py-4">Chưa có câu hỏi nào được tạo cho Quiz này.</div>
            }
            else
            {
                @foreach (var question in Model.Questions.OrderBy(q => q.QuestionID))
                {
                    <div class="card mb-4 shadow-sm">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <span class="fw-bold">Câu hỏi: @question.QuestionText</span>
                            @* Nút hành động Xóa Câu hỏi *@
                            <form asp-action="DeleteQuestion" method="post" onsubmit="return confirm('Xóa câu hỏi này sẽ xóa tất cả đáp án kèm theo. Bạn chắc chắn chứ?');">
                                <input type="hidden" name="questionId" value="@question.QuestionID" />
                                <button type="submit" class="btn btn-outline-danger btn-sm" title="Xóa Câu hỏi">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                        <div class="card-body pt-2">
                            <h6 class="mb-2">Đáp án:</h6>
                            <ul class="list-group list-group-flush mb-3">
                                @foreach (var answer in question.Answers)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center @(answer.IsCorrect ? "list-group-item-success" : "")">
                                        @answer.AnswerText
                                        <div class="small">
                                            @if (answer.IsCorrect)
                                            {
                                                <span class="badge bg-success me-2">Đáp án Đúng</span>
                                            }
                                            @* Nút Xóa Đáp án (Thêm form/logic nếu cần) *@
                                        </div>
                                    </li>
                                }
                            </ul>

                            @* Form Thêm Đáp án mới *@
                            <form asp-action="AddAnswer" method="post" class="mt-3">
                                <input type="hidden" name="questionId" value="@question.QuestionID" />
                                <div class="input-group">
                                    <input type="text" name="answerText" class="form-control" placeholder="Nhập nội dung đáp án mới" required>
                                    <div class="input-group-text">
                                        <input class="form-check-input mt-0" type="checkbox" name="isCorrect" value="true" title="Đặt làm đáp án đúng">
                                        <label class="ms-2">Đúng</label>
                                    </div>
                                    <button class="btn btn-outline-primary" type="submit">Thêm</button>
                                </div>
                            </form>
                        </div>
                    </div>
                }
            }
            <a asp-action="ManageCourse" asp-route-courseId="@Model.Lecture.CourseID" class="btn btn-outline-secondary mt-3">
                <i class="bi bi-arrow-left"></i> Quay lại Quản lý Khóa học
            </a>
        </div>
    </div>
</div>