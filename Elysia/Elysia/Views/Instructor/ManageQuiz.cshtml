@model Elysia.Models.Quiz
@{
    ViewData["Title"] = "Quản lý Quiz";
}

<div class="container py-4">
    <div class="mb-4">
        <h3 class="fw-bold">@Model.Title</h3>
        <p class="text-muted">Thêm câu hỏi và đáp án cho bài kiểm tra này.</p>
    </div>

    <div class="card shadow-sm mb-4 border-0">
        <div class="card-body bg-light">
            <h5 class="fw-bold mb-3">Thêm câu hỏi mới</h5>
            <form asp-action="AddQuestion" method="post">
                <input type="hidden" name="quizId" value="@Model.QuizID" />
                <div class="input-group">
                    <input type="text" name="questionText" class="form-control" placeholder="Nhập nội dung câu hỏi..." required />
                    <button class="btn btn-success"><i class="fas fa-plus"></i> Thêm</button>
                </div>
            </form>
        </div>
    </div>

    @foreach (var q in Model.Questions)
    {
        <div class="card mb-3 border-0 shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between">
                <span class="fw-bold text-primary">@q.QuestionText</span>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush mb-3">
                    @foreach (var ans in q.Answers)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@ans.AnswerText</span>
                            @if (ans.IsCorrect)
                            {
                                <span class="badge bg-success">Đúng</span>
                            }
                        </li>
                    }
                </ul>
                <form asp-action="AddAnswer" method="post" class="row g-2 align-items-center">
                    <input type="hidden" name="questionId" value="@q.QuestionID" />
                    <div class="col-8">
                        <input type="text" name="answerText" class="form-control form-control-sm" placeholder="Thêm đáp án..." required />
                    </div>
                    <div class="col-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="isCorrect" value="true" id="check_@q.QuestionID">
                            <label class="form-check-label small" for="check_@q.QuestionID">Là đáp án đúng</label>
                        </div>
                    </div>
                    <div class="col-2">
                        <button class="btn btn-sm btn-outline-primary w-100">Thêm</button>
                    </div>
                </form>
            </div>
        </div>
    }

    <div class="mt-3">
        <a asp-action="ManageCourse" asp-route-id="@Model.Lecture.CourseID" class="btn btn-secondary">Quay lại khóa học</a>
    </div>
</div>