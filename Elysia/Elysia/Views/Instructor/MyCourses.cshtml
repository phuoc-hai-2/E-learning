@model IEnumerable<Elysia.Models.Course>
@{
    ViewData["Title"] = "Quản lý khóa học";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="fas fa-chalkboard-teacher text-primary"></i> Khóa học của tôi</h2>
        <a asp-action="Create" class="btn btn-success shadow-sm"><i class="fas fa-plus"></i> Tạo khóa học mới</a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 bg-white rounded shadow-sm">
            <img src="https://cdn-icons-png.flaticon.com/512/7486/7486747.png" width="80" class="opacity-50 mb-3" alt="Empty">
            <h5 class="text-muted">Bạn chưa có khóa học nào.</h5>
            <a asp-action="Create" class="btn btn-primary mt-3">Bắt đầu tạo khóa học</a>
        </div>
    }
    else
    {
        <div class="table-responsive bg-white rounded shadow-sm">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3">Khóa học</th>
                        <th>Giá</th>
                        <th>Ngày tạo</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 py-3">
                                <div class="d-flex align-items-center">
                                    <img src="@(item.ImageUrl ?? "/images/default-course.png")" class="rounded me-3 border" width="60" height="60" style="object-fit:cover;">
                                    <div>
                                        <div class="fw-bold text-dark">@item.Title</div>
                                        <small class="text-muted d-block text-truncate" style="max-width: 250px;">@item.Description</small>
                                    </div>
                                </div>
                            </td>
                            <td class="fw-bold text-primary">@(item.Price == 0 ? "Miễn phí" : item.Price.ToString("N0") + " đ")</td>
                            <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="badge bg-success bg-opacity-10 text-success border border-success px-2 py-1">
                                    <i class="fas fa-check-circle me-1"></i> Đã hiển thị
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="EditCourse" asp-route-id="@item.CourseID" class="btn btn-sm btn-outline-secondary me-1" title="Sửa thông tin">
                                    <i class="fas fa-pen"></i> Sửa
                                </a>
                                <a asp-action="ManageCourse" asp-route-id="@item.CourseID" class="btn btn-sm btn-primary shadow-sm" title="Quản lý nội dung">
                                    <i class="fas fa-layer-group"></i> Nội dung
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>