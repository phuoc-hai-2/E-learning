@model Elysia.Models.Lecture

@{
    ViewData["Title"] = "Thêm bài giảng mới";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0">
                <div class="card-header bg-success text-white py-3">
                    <h4 class="mb-0"><i class="fas fa-plus-circle me-2"></i> Thêm Bài Giảng Mới</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="AddLecture" enctype="multipart/form-data" method="post">

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <input type="hidden" asp-for="CourseID" />

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-bold">Tiêu đề bài giảng</label>
                            <input asp-for="Title" class="form-control" placeholder="Nhập tên bài học..." />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Order" class="form-label fw-bold">Thứ tự hiển thị</label>
                            <input asp-for="Order" class="form-control w-25" type="number" min="1" value="1" />
                            <span asp-validation-for="Order" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Video bài giảng</label>
                            <input type="file" name="videoFile" class="form-control" accept="video/*" required />
                            <div class="form-text text-muted">Chọn file video từ máy tính của bạn (.mp4, .mkv...).</div>
                        </div>

                        <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                            <a asp-action="ManageCourse" asp-route-id="@Model.CourseID" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-success px-4 fw-bold">
                                <i class="bi bi-plus-lg me-1"></i> Thêm mới
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}