@{
    ViewData["Title"] = "Kết quả bài làm";
}
<div class="container d-flex justify-content-center align-items-center" style="min-height: 60vh;">
    <div class="card shadow-lg border-0 text-center p-5" style="width: 500px;">
        <div class="mb-4">
            @if (Model.Score >= 80)
            {
                <i class="fas fa-trophy text-warning display-1"></i>
            }
            else if (Model.Score >= 50)
            {

                <i class="fas fa-thumbs-up text-primary display-1"></i>
            }
            else
            {

                <i class="fas fa-sad-tear text-danger display-1"></i>
            }
        </div>
        <h2 class="fw-bold">Điểm số của bạn</h2>
        <h1 class="display-2 fw-bold @(Model.Score >= 50 ? "text-success" : "text-danger")">@Model.Score<span class="fs-4 text-muted">/100</span></h1>

        <p class="lead mt-3">
            Bạn trả lời đúng <strong class="text-dark">@Model.Correct</strong> trên tổng số <strong class="text-dark">@Model.Total</strong> câu hỏi.
        </p>

        <div class="d-grid gap-2 mt-4">
            <a asp-action="DoQuiz" asp-route-lectureId="@ViewBag.CourseId" class="btn btn-outline-primary">
                <i class="fas fa-redo"></i> Làm lại
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Quay lại khóa học
            </a>
        </div>
    </div>
</div>