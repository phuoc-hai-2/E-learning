@model Elysia.Models.Course
@{
    ViewData["Title"] = Model.Title; var firstLecture = Model.Lectures.OrderBy(l => l.Order).FirstOrDefault();
}

<div class="container-fluid py-3">
    <div class="row">
        <div class="col-lg-8">
            <div class="ratio ratio-16x9 bg-dark mb-3 rounded shadow">
                @if (firstLecture != null && !string.IsNullOrEmpty(firstLecture.VideoUrl))
                {
                    <video controls class="rounded">
                        <source src="@firstLecture.VideoUrl" type="video/mp4">
                        Trình duyệt không hỗ trợ thẻ video.
                    </video>
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center text-white h-100">Chọn bài học để bắt đầu</div>
                }
            </div>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="fw-bold mb-0">@(firstLecture?.Title ?? "Giới thiệu")</h3>
                @if (firstLecture != null)
                {
                    <div>
                        <button class="btn btn-outline-success me-2" onclick="markComplete(@firstLecture.LectureID, @Model.CourseID)">
                            <i class="fas fa-check-circle"></i> Hoàn thành bài
                        </button>
                        <a asp-action="DoQuiz" asp-route-lectureId="@firstLecture.LectureID" class="btn btn-warning fw-bold text-dark">
                            <i class="fas fa-gamepad"></i> Làm bài tập
                        </a>
                    </div>
                }
            </div>

            <hr />

            <div class="card border-0 shadow-sm mt-4">
                <div class="card-header bg-white fw-bold"><i class="fas fa-comments text-primary"></i> Thảo luận & Hỏi đáp</div>
                <div class="card-body">
                    @if (firstLecture != null)
                    {
                        <form asp-action="AddDiscussionComment" method="post" class="mb-4">
                            <input type="hidden" name="lectureId" value="@firstLecture.LectureID" />
                            <div class="input-group">
                                <input name="commentText" class="form-control" placeholder="Bạn có thắc mắc gì không?" required />
                                <button class="btn btn-primary"><i class="fas fa-paper-plane"></i> Gửi</button>
                            </div>
                        </form>
                        <div class="vstack gap-3" style="max-height: 500px; overflow-y: auto;">
                            @foreach (var c in firstLecture.Discussions)
                            {
                                <div class="d-flex border-bottom pb-2">
                                    <div class="flex-shrink-0">
                                        <img src="/images/default-avatar.png" class="rounded-circle" width="40">
                                    </div>
                                    <div class="flex-grow-1 ms-3">
                                        <div class="d-flex justify-content-between">
                                            <h6 class="fw-bold mb-0">@c.User?.FullName</h6>
                                            <small class="text-muted">@c.CreatedAt.ToString("dd/MM HH:mm")</small>
                                        </div>
                                        <p class="mb-0 text-dark">@c.Content</p>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white fw-bold">Nội dung khóa học</div>
                <div class="list-group list-group-flush overflow-auto" style="max-height: 80vh;">
                    @foreach (var l in Model.Lectures.OrderBy(x => x.Order))
                    {
                        <a href="#" class="list-group-item list-group-item-action @(l.LectureID == firstLecture?.LectureID ? "active" : "")">
                            <div class="d-flex w-100 justify-content-between">
                                <span class="mb-1"><i class="fas fa-play-circle me-2"></i> @l.Title</span>
                            </div>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function markComplete(lid, cid) {
        $.post('/Courses/CompleteLecture', { lectureId: lid, courseId: cid }, function(res) {
            if(res.success) alert("Đã cập nhật tiến độ học tập: " + res.progress + "%");
        });
    }
</script>