@model Elysia.Models.Course
@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-5">
    <div class="row">
        <!-- Left Content -->
        <div class="col-lg-8">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Search" class="text-decoration-none">Khóa học</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Chi tiết</li>
                </ol>
            </nav>

            <h1 class="fw-bold mb-3">@Model.Title</h1>
            <p class="lead text-muted">@Model.Description</p>

            <div class="d-flex align-items-center mb-4 p-3 bg-white rounded shadow-sm border">
                <img src="/images/default-avatar.png" class="rounded-circle me-3 border" width="50" height="50">
                <div>
                    <small class="text-uppercase text-muted fw-bold" style="font-size: 0.7rem;">Giảng viên</small>
                    <h6 class="mb-0 fw-bold">@Model.User?.FullName</h6>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-list-ul text-primary me-2"></i> Nội dung khóa học (@Model.Lectures.Count bài)</h5>
                </div>
                <div class="list-group list-group-flush">
                    @foreach (var l in Model.Lectures.OrderBy(x => x.Order))
                    {
                        <div class="list-group-item p-3 d-flex align-items-center">
                            <i class="fas fa-play-circle text-secondary me-3"></i>
                            <span>@l.Title</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Reviews Section -->
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h4 class="fw-bold mb-4">Đánh giá từ học viên</h4>
                    @if (!Model.Reviews.Any())
                    {
                        <p class="text-muted">Chưa có đánh giá nào.</p>
                    }
                    else
                    {
                        @foreach (var rv in Model.Reviews.OrderByDescending(r => r.CreatedAt))
                        {
                            <div class="border-bottom pb-3 mb-3">
                                <div class="d-flex justify-content-between">
                                    <h6 class="fw-bold">@rv.User?.FullName</h6>
                                    <div class="text-warning small">
                                        @for (int i = 0; i < rv.Rating; i++)
                                        {
                                            <i class="fas fa-star"></i>
                                        }
                                    </div>
                                </div>
                                <p class="mb-1 text-secondary">@rv.Comment</p>
                                <small class="text-muted" style="font-size:0.8rem;">@rv.CreatedAt.ToString("dd/MM/yyyy")</small>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Right Sidebar (Sticky Price) -->
        <div class="col-lg-4">
            <div class="card shadow border-0 sticky-top" style="top: 90px;">
                <img src="@(Model.ImageUrl ?? "/images/default-course.png")" class="card-img-top" style="height: 200px; object-fit: cover;">
                <div class="card-body p-4">
                    <h2 class="text-primary fw-bold mb-3 text-center">
                        @(Model.Price == 0 ? "Miễn phí" : Model.Price.ToString("N0") + " VNĐ")
                    </h2>

                    <form asp-action="Enroll" method="post">
                        <input type="hidden" name="id" value="@Model.CourseID" />
                        <button class="btn btn-danger w-100 btn-lg fw-bold shadow-sm py-3">
                            <i class="fas fa-cart-plus me-2"></i> ĐĂNG KÝ HỌC NGAY
                        </button>
                    </form>

                    <div class="mt-4 pt-3 border-top">
                        <ul class="list-unstyled small text-muted mb-0">
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i> Truy cập trọn đời</li>
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i> Học trên mọi thiết bị</li>
                            <li><i class="fas fa-check text-success me-2"></i> Cấp chứng chỉ hoàn thành</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>