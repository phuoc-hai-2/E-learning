@model IEnumerable<Elysia.Models.Course>

@{
    ViewData["Title"] = "Tìm kiếm Khóa học";
}

<div class="container mt-4">
    <h2 class="mb-4">Tìm Kiếm Khóa Học</h2>
    <form asp-action="Search" method="get" class="mb-4">
        <div class="input-group">
            <input type="text" name="query" class="form-control form-control-lg" placeholder="Nhập tên khóa học..." value="@ViewBag.SearchQuery" />
            <button class="btn btn-primary btn-lg" type="submit"><i class="fas fa-search"></i> Tìm kiếm</button>
        </div>
    </form>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning text-center">
            Không tìm thấy khóa học nào phù hợp với yêu cầu của bạn.
        </div>
    }
    else
    {
        <p class="text-muted">Tìm thấy **@Model.Count()** khóa học đã được duyệt.</p>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var course in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <img src="@(course.ImageUrl ?? "/images/default-course.png")" class="card-img-top"
                             alt="@course.Title" style="height: 180px; object-fit: cover;">

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold">@course.Title</h5>
                            <p class="card-text text-muted small">Giảng viên: @(course.User?.FullName ?? "N/A")</p>

                            <p class="card-text flex-grow-1">
                                @(course.Description.Length > 80 ? course.Description.Substring(0, 80) + "..." : course.Description)
                            </p>

                            <div class="mt-auto pt-2">
                                <h4 class="text-danger fw-bolder mb-2">
                                    @(course.Price == 0 ? "Miễn phí" : $"{course.Price:N0} VNĐ")
                                </h4>
                                <a asp-action="Details" asp-route-id="@course.CourseID" class="btn btn-outline-primary w-100">
                                    Xem chi tiết & Đăng ký
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>