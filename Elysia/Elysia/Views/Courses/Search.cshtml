@model IEnumerable<Elysia.Models.Course>
@{
    ViewData["Title"] = "Tìm kiếm khóa học";
}

<div class="container py-5">
    <!-- Search Header -->
    <div class="text-center mb-5">
        <h1 class="fw-bold display-5 mb-3">Khám phá Khóa học</h1>
        <form asp-action="Search" method="get" class="d-flex justify-content-center">
            <div class="input-group w-50 shadow-sm">
                <input type="text" name="searchQuery" class="form-control form-control-lg border-0" placeholder="Bạn muốn học gì hôm nay?" value="@Context.Request.Query["searchQuery"]" />
                <button class="btn btn-primary px-4"><i class="fas fa-search"></i></button>
            </div>
        </form>
    </div>

    <!-- Results -->
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <p class="text-muted lead">Không tìm thấy khóa học nào phù hợp.</p>
            <a asp-action="Search" class="btn btn-outline-primary">Xem tất cả</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var course in Model)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm hover-shadow transition">
                        <img src="@(course.ImageUrl ?? "/images/default-course.png")" class="card-img-top" style="height: 200px; object-fit: cover;" alt="@course.Title">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold text-truncate" title="@course.Title">@course.Title</h5>
                            <p class="card-text small text-muted mb-2">
                                <i class="fas fa-chalkboard-teacher"></i> @(course.User?.FullName ?? "Giảng viên")
                            </p>
                            <p class="card-text text-secondary flex-grow-1 small">
                                @(course.Description?.Length > 90 ? course.Description.Substring(0, 90) + "..." : course.Description)
                            </p>
                            <div class="mt-3 d-flex justify-content-between align-items-center">
                                <span class="h5 mb-0 text-primary fw-bold">
                                    @(course.Price == 0 ? "Miễn phí" : course.Price.ToString("N0") + " đ")
                                </span>
                                <a asp-action="Details" asp-route-id="@course.CourseID" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                    Chi tiết
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>