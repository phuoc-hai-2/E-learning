@model IEnumerable<Elysia.Models.Enrollment>

@{
    ViewData["Title"] = "Khóa học của tôi";
}

<div class="container mt-4">
    <h2 class="mb-4">📖 Khóa học của tôi</h2>
    <p>Tiếp tục hành trình học tập của bạn.</p>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center">
            Bạn chưa đăng ký khóa học nào. <a asp-action="Search" class="alert-link">Khám phá các khóa học ngay!</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var enrollment in Model)
            {
                var course = enrollment.Course;

                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <img src="@(course.ImageUrl ?? "/images/default-course.png")" class="card-img-top"
                             alt="@course.Title" style="height: 180px; object-fit: cover;">

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold">@course.Title</h5>
                            <p class="card-text text-muted small">Giảng viên: @(course.User?.FullName ?? "N/A")</p>

                            <div class="mt-auto">
                                <div class="progress mb-2" style="height: 20px;">
                                    <div class="progress-bar bg-primary" role="progressbar"
                                         style="width: @(enrollment.ProgressPercent)%"
                                         aria-valuenow="@enrollment.ProgressPercent" aria-valuemin="0" aria-valuemax="100">
                                        @enrollment.ProgressPercent.ToString("N0")%
                                    </div>
                                </div>
                                <a asp-action="Watch" asp-route-id="@course.CourseID" class="btn btn-primary w-100">
                                    <i class="fas fa-play-circle"></i> Tiếp tục học
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>