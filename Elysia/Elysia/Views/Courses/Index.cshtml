@model IEnumerable<Elysia.Models.Enrollment>
@{
    ViewData["Title"] = "Việc học tập";
}

<div class="py-4">
    <h2 class="fw-bold mb-4"><i class="fas fa-book-reader text-primary"></i> Khóa học của tôi</h2>
    @if (!Model.Any())
    {
        <div class="alert alert-info text-center p-5 rounded-3">
            <h4>Bạn chưa đăng ký khóa học nào.</h4>
            <a asp-action="Search" class="btn btn-primary mt-3">Tìm khóa học ngay</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm border-0 hover-shadow">
                        <img src="@(item.Course.ImageUrl ?? "/images/default-course.png")" class="card-img-top" style="height:180px; object-fit:cover;">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold text-truncate">@item.Course.Title</h5>
                            <p class="text-muted small mb-2">GV: @item.Course.User.FullName</p>
                            <div class="mt-auto">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span>Tiến độ</span>
                                    <span class="fw-bold">@item.ProgressPercent%</span>
                                </div>
                                <div class="progress mb-3" style="height: 8px;">
                                    <div class="progress-bar bg-success" style="width: @item.ProgressPercent%"></div>
                                </div>
                                <a asp-action="Watch" asp-route-id="@item.CourseID" class="btn btn-primary w-100">
                                    <i class="fas fa-play-circle"></i> Vào học
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>