@model IEnumerable<Elysia.Models.Enrollment>
@{
    ViewData["Title"] = "Việc học tập";
}

<div class="py-4">
    <h2 class="fw-bold mb-4"><i class="fas fa-book-reader text-primary"></i> Khóa học của tôi</h2>
    @if (!Model.Any())
    {
        <div class="alert alert-info text-center p-5 rounded-3 shadow-sm border-0">
            <div class="mb-3"><i class="fas fa-search fa-3x opacity-50"></i></div>
            <h4>Bạn chưa đăng ký khóa học nào.</h4>
            <p class="text-muted">Hãy khám phá thư viện khóa học của chúng tôi để bắt đầu.</p>
            <a asp-action="Search" class="btn btn-primary mt-2 px-4 fw-bold">Tìm khóa học ngay</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm border-0 hover-shadow overflow-hidden">
                        <img src="@(item.Course.ImageUrl ?? "/images/default-course.png")" class="card-img-top" style="height:180px; object-fit:cover;">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold text-truncate" title="@item.Course.Title">@item.Course.Title</h5>
                            <p class="text-muted small mb-2"><i class="fas fa-user-tie me-1"></i> GV: @(item.Course.User?.FullName ?? "Unknown")</p>
                            <div class="mt-auto">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span>Tiến độ</span>
                                    <span class="fw-bold text-primary">@item.ProgressPercent%</span>
                                </div>
                                <div class="progress mb-3 rounded-pill" style="height: 8px;">
                                    <div class="progress-bar bg-success" role="progressbar" style="width: @item.ProgressPercent%"></div>
                                </div>
                                <a asp-action="Watch" asp-route-id="@item.CourseID" class="btn btn-primary w-100 fw-bold">
                                    <i class="fas fa-play-circle me-1"></i> @(item.ProgressPercent > 0 ? "Tiếp tục học" : "Bắt đầu học")
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>