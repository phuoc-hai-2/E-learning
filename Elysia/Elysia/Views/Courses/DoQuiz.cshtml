@model Elysia.Models.Quiz
@{
    ViewData["Title"] = "Bài tập trắc nghiệm";
}

<div class="container mt-5" style="max-width: 800px;">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-gradient bg-primary text-white text-center py-4 rounded-top">
            <h2 class="fw-bold mb-0"><i class="fas fa-puzzle-piece"></i> @Model.Title</h2>
            <p class="mb-0 opacity-75">Chọn đáp án đúng nhất cho mỗi câu hỏi</p>
        </div>
        <div class="card-body p-5 bg-light">
            <form asp-action="SubmitQuiz" method="post">
                <input type="hidden" name="quizId" value="@Model.QuizID" />

                @if (!Model.Questions.Any())
                {
                    <div class="alert alert-warning text-center">Chưa có câu hỏi nào.</div>
                }
                else
                {
                    int i = 1;
                    foreach (var q in Model.Questions)
                    {
                        <div class="card mb-4 border-0 shadow-sm">
                            <div class="card-body p-4">
                                <h5 class="fw-bold text-dark mb-3"><span class="badge bg-secondary me-2">Câu @i</span> @q.QuestionText</h5>
                                <div class="vstack gap-2">
                                    @foreach (var ans in q.Answers)
                                    {
                                        <label class="btn btn-outline-dark text-start p-3 rounded-3 border-2 position-relative">
                                            <input type="radio" name="answers[@q.QuestionID]" value="@ans.AnswerID" class="btn-check" required>
                                            <span class="fw-semibold">@ans.AnswerText</span>
                                        </label>
                                    }
                                </div>
                            </div>
                        </div>
                        i++;
                    }
                    <div class="text-center mt-4">
                        <button type="submit" class="btn btn-success btn-lg px-5 py-3 rounded-pill fw-bold shadow">
                            <i class="fas fa-paper-plane me-2"></i> Nộp bài & Xem điểm
                        </button>
                    </div>
                }
            </form>
        </div>
    </div>
</div>
<style>
    .btn-check:checked + span {
        color: white;
    }

    .btn-outline-dark:has(:checked) {
        background-color: #0d6efd;
        border-color: #0d6efd;
        color: white;
    }
</style>