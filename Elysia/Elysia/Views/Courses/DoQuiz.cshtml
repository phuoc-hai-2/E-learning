@model Elysia.Models.Quiz
@* Giả định Model là một đối tượng Quiz đã được load kèm Questions và Answers *@

@{
    ViewData["Title"] = "Làm Bài Kiểm tra: " + Model.Title;
}

<div class="row justify-content-center pt-4">
    <div class="col-lg-8">
        <div class="card shadow-lg">
            <div class="card-header bg-warning text-dark h4 text-center">
                <i class="bi bi-alarm-fill"></i> Bài Kiểm tra: @Model.Title
            </div>
            <div class="card-body p-4">
                <p class="text-center text-muted">Tổng cộng **@Model.Questions.Count** câu hỏi. Thời gian: 30 phút.</p>

                <form asp-action="SubmitQuiz" method="post">
                    <input type="hidden" name="quizId" value="@Model.QuizID" />

                    @for (int i = 0; i < Model.Questions.Count; i++)
                    {
                        var question = Model.Questions.ElementAt(i);
                        <div class="card mb-4 border-primary">
                            <div class="card-header h6 bg-light">
                                Câu hỏi @(i + 1):
                            </div>
                            <div class="card-body">
                                <p class="card-text fw-bold">@question.QuestionText</p>

                                @* Hiển thị các câu trả lời (Radio button) *@
                                <div class="mt-3">
                                    @foreach (var answer in question.Answers)
                                    {
                                        <div class="form-check mb-2">
                                            <input class="form-check-input" type="radio"
                                                   name="question_@question.QuestionID"
                                                   id="answer_@answer.AnswerID"
                                                   value="@answer.AnswerID" required>
                                            <label class="form-check-label" for="answer_@answer.AnswerID">
                                                @answer.AnswerText
                                            </label>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    <div class="text-center mt-5">
                        <button type="submit" class="btn btn-success btn-lg px-5">
                            <i class="bi bi-send-fill"></i> Nộp bài kiểm tra
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @* Thêm đồng hồ đếm ngược (nếu cần) *@
}