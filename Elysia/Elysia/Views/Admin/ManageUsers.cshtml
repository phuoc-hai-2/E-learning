@model IEnumerable<Elysia.Models.ApplicationUser>
@{
    ViewData["Title"] = "Quản lý Người dùng";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0"><i class="fas fa-users-cog text-primary me-2"></i> Quản lý Người dùng</h2>
        <span class="badge bg-primary fs-6">Tổng: @Model.Count()</span>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-dark text-white">
                    <tr>
                        <th class="ps-4 py-3">User Info</th>
                        <th>Email</th>
                        <th>Vai trò</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark">@user.FullName</div>
                                <small class="text-muted">ID: @user.Id.Substring(0, 8)...</small>
                            </td>
                            <td>@user.Email</td>
                            <td>
                                <!-- Note: You'd ideally fetch roles in controller, simple check here -->
                                <span class="badge bg-secondary">User</span>
                            </td>
                            <td>
                                @if (user.LockoutEnd != null && user.LockoutEnd > DateTimeOffset.UtcNow)
                                {
                                    <span class="badge bg-danger"><i class="fas fa-lock me-1"></i> Đã khóa</span>
                                }
                                else
                                {
                                    <span class="badge bg-success"><i class="fas fa-check me-1"></i> Hoạt động</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                @if (user.Email != "admin@elysia.com")
                                {
                                    <div class="btn-group">
                                        @if (user.LockoutEnd != null && user.LockoutEnd > DateTimeOffset.UtcNow)
                                        {
                                            <form asp-action="UnlockUser" method="post">
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <button class="btn btn-sm btn-success" title="Mở khóa"><i class="fas fa-unlock"></i></button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="LockUser" method="post" onsubmit="return confirm('Chặn người dùng này?');">
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <button class="btn btn-sm btn-warning text-dark" title="Chặn"><i class="fas fa-ban"></i></button>
                                            </form>
                                        }

                                        <form asp-action="DeleteUser" method="post" onsubmit="return confirm('Xóa vĩnh viễn?');" class="ms-1">
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <button class="btn btn-sm btn-danger" title="Xóa"><i class="fas fa-trash"></i></button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small fst-italic">Admin chính</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>