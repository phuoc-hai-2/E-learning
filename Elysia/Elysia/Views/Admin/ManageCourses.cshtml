@model IEnumerable<Elysia.Models.Course>
@{
    ViewData["Title"] = "Quản lý tất cả khóa học";
}

<div class="container mt-4">
    <h2 class="text-danger fw-bold mb-4"><i class="fas fa-shield-alt me-2"></i> Quản lý & Kiểm duyệt Khóa học</h2>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 bg-white">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3">Thông tin Khóa học</th>
                        <th>Giảng viên</th>
                        <th>Giá</th>
                        <th>Ngày đăng</th>
                        <th class="text-end pe-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <img src="@(item.ImageUrl ?? "/images/default-course.png")" style="width: 45px; height: 45px; object-fit:cover;" class="rounded me-3 border" />
                                    <div class="fw-bold text-truncate text-dark" style="max-width: 250px;" title="@item.Title">@item.Title</div>
                                </div>
                            </td>
                            <td><span class="badge bg-info text-dark"><i class="fas fa-user me-1"></i> @item.User?.FullName</span></td>
                            <td class="fw-bold text-secondary">@(item.Price == 0 ? "Free" : item.Price.ToString("N0"))</td>
                            <td class="small text-muted">@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td class="text-end pe-4">
                                <form asp-action="DeleteCourse" method="post" onsubmit="return confirm('CẢNH BÁO ADMIN: Bạn có chắc chắn muốn GỠ BỎ khóa học này? Dữ liệu sẽ bị xóa vĩnh viễn.');">
                                    <input type="hidden" name="courseId" value="@item.CourseID" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm fw-bold">
                                        <i class="fas fa-ban me-1"></i> Gỡ bài
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>