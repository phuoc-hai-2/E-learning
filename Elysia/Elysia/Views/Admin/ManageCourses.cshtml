@model IEnumerable<Elysia.Models.Course>
@{
    ViewData["Title"] = "Quản lý tất cả khóa học";
}

<div class="container mt-4">
    <h2 class="text-danger fw-bold mb-4"><i class="fas fa-tasks"></i> Quản lý & Gỡ Khóa học</h2>

    <div class="table-responsive shadow-sm rounded bg-white">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Tên Khóa học</th>
                    <th>Giảng viên</th>
                    <th>Giá</th>
                    <th>Trạng thái</th>
                    <th class="text-end pe-4">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center">
                                <img src="@(item.ImageUrl ?? "/images/default-course.png")" style="width: 45px; height: 45px; object-fit:cover;" class="rounded-circle me-2" />
                                <div class="fw-bold text-truncate" style="max-width: 250px;">@item.Title</div>
                            </div>
                        </td>
                        <td>@item.User?.FullName</td>
                        <td>@(item.Price == 0 ? "Miễn phí" : item.Price.ToString("N0") + " đ")</td>
                        <td><span class="badge bg-success">Đang hiển thị</span></td>
                        <td class="text-end pe-4">
                            <form asp-action="DeleteCourse" method="post" onsubmit="return confirm('CẢNH BÁO: Bạn có chắc chắn muốn GỠ khóa học này? Dữ liệu không thể phục hồi.');">
                                <input type="hidden" name="courseId" value="@item.CourseID" />
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    <i class="fas fa-trash-alt"></i> Gỡ bài
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>