@using Microsoft.AspNetCore.Identity
@using Elysia.Models

@* Tải dịch vụ SignInManager và UserManager để kiểm tra đăng nhập và lấy thông tin user *@
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        @* Lấy thông tin user hiện tại *@
        var user = await UserManager.GetUserAsync(User);
        var userName = user?.FullName ?? user?.UserName; // Ưu tiên hiển thị FullName nếu có

        @* Nếu đã đăng nhập: Hiển thị tên và nút Đăng xuất *@
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
                Chào, @userName!
            </a>
        </li>
        <li class="nav-item">
            @* Nút đăng xuất BẮT BUỘC phải là một Form (để bảo mật) *@
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="nav-link btn btn-link text-dark">Đăng xuất</button>
            </form>
        </li>
    }
    else
    {
        @* Nếu chưa đăng nhập: Hiển thị Đăng ký và Đăng nhập *@
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">Đăng ký</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Đăng nhập</a>
        </li>
    }
</ul>