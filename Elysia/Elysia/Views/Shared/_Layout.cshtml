<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Elysia E-Learning</title>

    <!-- CSS Dependencies -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Elysia.styles.css" asp-append-version="true" />
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        .hover-shadow:hover {
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
            transition: .3s;
        }

        .cursor-pointer {
            cursor: pointer;
        }
        /* Notification Badge */
        #noti-badge {
            font-size: 0.65rem;
            padding: 0.25em 0.4em;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm sticky-top">
            <div class="container">
                <a class="navbar-brand fw-bold text-primary fs-4" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-graduation-cap"></i> Elysia
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity.IsAuthenticated)
                        {
                            // === ADMIN AREA ===
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Admin" asp-action="Index">Dashboard</a></li>
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Admin" asp-action="ManageCourses">Quản lý Khóa học</a></li>
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Admin" asp-action="ApproveInstructors">Duyệt Giảng viên</a></li>
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Admin" asp-action="ManageUsers">Quản lý User</a></li>
                            }
                            // === INSTRUCTOR AREA ===
                            else if (User.IsInRole("GiangVien"))
                            {
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Instructor" asp-action="Index">Thống kê</a></li>
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Instructor" asp-action="MyCourses">Khóa học của tôi</a></li>
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Instructor" asp-action="Create">Đăng bài mới</a></li>
                            }
                            // === STUDENT AREA ===
                            else if (User.IsInRole("SinhVien"))
                            {
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Courses" asp-action="Index">Việc học tập</a></li>
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Courses" asp-action="Search">Tìm khóa học</a></li>
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Payment" asp-action="Index">Lịch sử giao dịch</a></li>
                            }
                        }
                        else
                        {
                            // === GUEST ===
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home" asp-action="Privacy">Về chúng tôi</a></li>
                        }
                    </ul>

                    <!-- Right Side: Notifications & User Profile -->
                    <ul class="navbar-nav align-items-center">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <!-- NOTIFICATION BELL -->
                            <li class="nav-item dropdown me-3">
                                <a class="nav-link text-dark position-relative" href="#" id="notiDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-bell fa-lg"></i>
                                    <span id="noti-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display:none;">
                                        0
                                    </span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="notiDropdown" id="noti-list" style="width: 320px; max-height: 400px; overflow-y: auto;">
                                    <li><h6 class="dropdown-header fw-bold text-primary">Thông báo mới</h6></li>
                                    <li><hr class="dropdown-divider m-0"></li>
                                    <li class="text-center p-3 text-muted"><small>Đang tải...</small></li>
                                </ul>
                            </li>
                        }

                        <!-- Login Partial -->
                        <partial name="_LoginPartial" />
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1 pb-3">
        <main role="main">
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white py-3 mt-auto">
        <div class="container text-center">
            &copy; 2025 - <strong>Elysia E-Learning</strong> - <a asp-controller="Home" asp-action="Privacy">Chính sách bảo mật</a>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- NOTIFICATION LOGIC (Ajax Polling) -->
    @if (User.Identity.IsAuthenticated)
    {
        <script>
            $(document).ready(function() {
                // Load notifications immediately
                loadNotifications();

                // Poll every 60 seconds
                setInterval(loadNotifications, 60000);

                function loadNotifications() {
                    $.ajax({
                        url: "/Notification/GetNotifications",
                        type: "GET",
                        success: function(data) {
                            // 1. Update Badge
                            if (data.unreadCount > 0) {
                                $("#noti-badge").text(data.unreadCount).show();
                            } else {
                                $("#noti-badge").hide();
                            }

                            // 2. Update Dropdown List
                            var html = '<li><h6 class="dropdown-header fw-bold text-primary">Thông báo</h6></li><li><hr class="dropdown-divider m-0"></li>';

                            if (data.notifications.length === 0) {
                                html += '<li class="text-center p-3 text-muted"><small>Không có thông báo nào</small></li>';
                            } else {
                                $.each(data.notifications, function(index, item) {
                                    // Unread items have light background
                                    var bgStyle = item.isRead ? 'bg-white' : 'bg-light fw-semibold';

                                    html += `
                                        <li>
                                            <a class="dropdown-item ${bgStyle} py-2 text-wrap border-bottom" href="${item.url}" onclick="markRead(${item.notificationID})">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <span class="text-dark small">${item.message}</span>
                                                </div>
                                                <small class="text-muted" style="font-size: 0.7rem;">
                                                    <i class="far fa-clock"></i> ${item.createdAt}
                                                </small>
                                            </a>
                                        </li>`;
                                });
                            }
                            $("#noti-list").html(html);
                        },
                        error: function() {
                            console.log("Không thể tải thông báo.");
                        }
                    });
                }
            });

            // Mark as Read function: Declared OUTSIDE $(document).ready() to make it global
            window.markRead = function(id) {
                $.post("/Notification/MarkAsRead", { id: id });
            }
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>