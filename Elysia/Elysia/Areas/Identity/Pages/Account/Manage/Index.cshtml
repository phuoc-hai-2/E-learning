@page
@model IndexModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div class="container-fluid p-0">
    <h3 class="mb-4 text-primary fw-bold"><i class="fas fa-user-cog me-2"></i>@ViewData["Title"]</h3>

    <partial name="_StatusMessage" for="StatusMessage" />

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form id="profile-form" method="post" enctype="multipart/form-data">
                <div class="row">
                    <div class="col-md-8">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Username" class="form-control bg-light" placeholder="Username" disabled />
                            <label asp-for="Username" class="form-label text-muted">Tên đăng nhập / Email</label>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.FullName" class="form-control" placeholder="Nhập họ và tên" />
                            <label asp-for="Input.FullName" class="form-label">Họ và tên đầy đủ</label>
                            <span asp-validation-for="Input.FullName" class="text-danger"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Nhập số điện thoại" />
                            <label asp-for="Input.PhoneNumber" class="form-label">Số điện thoại</label>
                            <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                        </div>

                        <div class="mt-4">
                            <button id="update-profile-button" type="submit" class="btn btn-primary px-4 py-2 fw-bold">
                                <i class="fas fa-save me-2"></i> Lưu thay đổi
                            </button>
                        </div>
                    </div>

                    <div class="col-md-4 text-center border-start">
                        <label class="form-label fw-bold mb-3">Ảnh đại diện</label>

                        <div class="mb-3 position-relative d-inline-block">
                            <img src="@Model.Input.CurrentAvatarUrl"
                                 id="avatar-preview"
                                 class="rounded-circle shadow-sm border"
                                 style="width: 180px; height: 180px; object-fit: cover;"
                                 alt="Avatar"
                                 onerror="this.src='/images/default-avatar.png'" />

                            <label for="avatar-upload" class="position-absolute bottom-0 end-0 bg-white rounded-circle shadow p-2 border" style="cursor: pointer;">
                                <i class="fas fa-camera text-primary"></i>
                            </label>
                        </div>

                        <div class="mt-2">
                            <input asp-for="Input.AvatarFile" type="file" id="avatar-upload" class="form-control form-control-sm d-none" accept="image/*" onchange="previewImage(this)" />
                            <span class="text-muted small">Nhấn vào icon máy ảnh để thay đổi</span>
                            <br />
                            <span asp-validation-for="Input.AvatarFile" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('avatar-preview').src = e.target.result;
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}