@page
@model LoginModel

@{
    ViewData["Title"] = "Đăng nhập hệ thống";
}

<div class="row justify-content-center pt-5">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="text-center mb-4">
            <h1 class="display-5">Chào mừng trở lại!</h1>
            <p class="text-muted">Truy cập vào các khóa học và tài nguyên của bạn.</p>
        </div>

        <div class="row">

            @* === Cột 1: Đăng nhập bằng tài khoản cục bộ === *@
            <div class="col-12 col-lg-6 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body p-4">
                        <section>
                            <h2 class="h5 card-title mb-3">Đăng nhập bằng Email</h2>
                            <form id="account" method="post">
                                <hr />
                                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

                                <div class="form-floating mb-3">
                                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                                    <label asp-for="Input.Email">Email</label>
                                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                                </div>
                                <div class="form-floating mb-3">
                                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                                    <label asp-for="Input.Password">Mật khẩu</label>
                                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div class="form-check">
                                        <input class="form-check-input" asp-for="Input.RememberMe" />
                                        <label class="form-check-label" asp-for="Input.RememberMe">
                                            @Html.DisplayNameFor(m => m.Input.RememberMe)
                                        </label>
                                    </div>
                                    <a id="forgot-password" asp-page="./ForgotPassword" class="small text-decoration-none">Quên mật khẩu?</a>
                                </div>

                                <div>
                                    <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">Đăng nhập</button>
                                </div>

                                <div class="mt-3 text-center">
                                    <p class="mb-1">
                                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="small text-decoration-none">Chưa có tài khoản? **Đăng ký ngay**</a>
                                    </p>
                                    <p class="mb-0">
                                        <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="small text-decoration-none">Gửi lại email xác nhận</a>
                                    </p>
                                </div>
                            </form>
                        </section>
                    </div>
                </div>
            </div>

            @* === Cột 2: Đăng nhập bằng dịch vụ ngoài === *@
            <div class="col-12 col-lg-6 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body p-4">
                        <section>
                            <h2 class="h5 card-title mb-3">Hoặc dùng dịch vụ khác</h2>
                            <hr />
                            @{
                                if ((Model.ExternalLogins?.Count ?? 0) == 0)
                                {
                                    <div class="alert alert-info small" role="alert">
                                        <p>
                                            Chưa có dịch vụ xác thực ngoài nào được cấu hình.
                                            Xem hướng dẫn thiết lập trong tài liệu ASP.NET Identity.
                                        </p>
                                    </div>
                                }
                                else
                                {
                                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                                        <div>
                                            <p>
                                                @foreach (var provider in Model.ExternalLogins!)
                                                {
                                                    <button type="submit" class="w-100 btn btn-outline-secondary mb-2"
                                                            name="provider" value="@provider.Name"
                                                            title="Đăng nhập bằng tài khoản @provider.DisplayName">
                                                        <i class="bi bi-person-fill"></i> Đăng nhập bằng @provider.DisplayName
                                                    </button>
                                                }
                                            </p>
                                        </div>
                                    </form>
                                }
                            }
                        </section>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}